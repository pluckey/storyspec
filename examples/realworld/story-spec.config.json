{
  "$schema": "./node_modules/story-spec/schema/story-spec.config.schema.json",
  "testCommand": "python3 -m pytest -q -p no:cacheprovider --junitxml=.story-spec/junit.xml",
  "testReport": ".story-spec/junit.xml",
  "storyMayImport": [],
  "wiring": [],
  "layers": {
    "app/domain": [
      "app/domain"
    ],
    "app/ports": [
      "app/domain",
      "app/ports"
    ],
    "app/usecases": [
      "app/domain",
      "app/ports",
      "app/usecases"
    ],
    "app/adapters": [
      "app/domain",
      "app/ports",
      "app/adapters"
    ],
    "app/entry": [
      "app"
    ]
  },
  "ignore": [
    "node_modules",
    "dist",
    ".story-spec",
    ".git",
    ".venv",
    "hurl"
  ],
  "defaultProof": [
    "local",
    "deployed"
  ],
  "tiers": {
    "deployed": {
      "command": "scripts/deployed.sh",
      "report": [
        ".story-spec/pytest.xml",
        ".story-spec/hurl.xml"
      ]
    }
  }
}
